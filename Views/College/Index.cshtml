@model IEnumerable<EducareSA.Models.College>

@{
    ViewData["Title"] = "Colleges";
}

<div class="container py-5">

    <div class="text-center mb-5">
        <h1>TVET Colleges</h1>

        <p class="text-muted mx-auto"
           style="max-width: 700px;">
            Explore public TVET colleges, their campuses,
            programmes and admission information.
        </p>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            College information is currently being added.
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var college in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card h-100 shadow-sm">

                        <div class="card-body d-flex flex-column">

                            <h4 class="card-title">
                                @college.Name
                            </h4>

                            <p class="text-muted mb-2">
                                <i class="fas fa-map-marker-alt me-1"></i>
                                @(college.City ?? "Location not provided"),
                                @(college.Province ?? "")
                            </p>

                            @if (!string.IsNullOrWhiteSpace(
                                                college.Description))
                            {
                                <p class="card-text">
                                    @college.Description
                                </p>
                            }

                            <div class="mt-auto pt-3">

                                <a asp-action="Details"
                                   asp-route-id="@college.CollegeId"
                                   class="btn btn-primary">
                                    View College
                                </a>

                                @if (!string.IsNullOrWhiteSpace(
                                                        college.WebsiteUrl))
                                {
                                    <a href="@college.WebsiteUrl"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="btn btn-outline-secondary">
                                        Official Website
                                    </a>
                                }

                            </div>

                        </div>
                    </div>

                </div>
            }

        </div>
    }
</div>