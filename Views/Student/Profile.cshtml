@model EducareSA.ViewModels.StudentProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}

<section style="padding: 48px 0 32px; background: linear-gradient(135deg, var(--beige-light) 0%, var(--cream) 100%);">
    <div class="shell">
        <div style="display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap;" data-aos="fade-right">
            <div>
                <span class="eyebrow">My account</span>
                <h1 style="font-size: clamp(1.75rem, 3.5vw, 2.5rem); margin-bottom: 8px;">My profile</h1>
                <p style="color: var(--brown-medium); margin: 0;">
                    Keep your details up to date — they help us match you accurately.
                </p>
            </div>
            <a asp-action="Results" class="btn-pill-outline btn-pill">
                <i class="fas fa-book-open" style="font-size: 0.8rem;"></i>
                My results
            </a>
        </div>
    </div>
</section>

<section style="padding: 40px 0 100px;">
    <div class="shell">
        <div class="profile-layout">

            <!-- LEFT: form -->
            <div>
                <form asp-action="Profile" method="post" class="card" style="padding: 32px; border-radius: var(--r-lg);" data-aos="fade-up">
                    <div asp-validation-summary="ModelOnly" class="text-danger small" style="margin-bottom: 16px;"></div>
                    <input type="hidden" asp-for="StudentId" />

                    <h3 style="font-family: var(--font-display); margin: 0 0 24px; font-size: 1.2rem;">
                        Personal details
                    </h3>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
                        <div>
                            <label asp-for="FirstName" class="form-label"></label>
                            <input asp-for="FirstName" class="form-control" />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>
                        <div>
                            <label asp-for="LastName" class="form-label"></label>
                            <input asp-for="LastName" class="form-control" />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>
                    </div>

                    <div style="margin-bottom: 20px;">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" readonly
                               style="background: var(--beige-light); cursor: not-allowed;" />
                        <div style="font-size: 0.78rem; color: var(--brown-medium); margin-top: 6px;">
                            Email is linked to your login and can't be changed here.
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
                        <div>
                            <label asp-for="DateOfBirth" class="form-label"></label>
                            <input asp-for="DateOfBirth" type="date" class="form-control" />
                        </div>
                        <div>
                            <label asp-for="Province" class="form-label"></label>
                            <input asp-for="Province" class="form-control" placeholder="e.g. KwaZulu-Natal" />
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 20px; margin-bottom: 28px;">
                        <div>
                            <label asp-for="SchoolName" class="form-label"></label>
                            <input asp-for="SchoolName" class="form-control" />
                        </div>
                        <div>
                            <label asp-for="Grade" class="form-label"></label>
                            <input asp-for="Grade" class="form-control" type="number" min="8" max="12" />
                            <span asp-validation-for="Grade" class="text-danger small"></span>
                        </div>
                    </div>

                    <button type="submit" class="btn-pill">
                        <i class="fas fa-check" style="font-size: 0.8rem;"></i>
                        Save changes
                    </button>
                </form>
            </div>

            <!-- RIGHT: APS sidebar -->
            <aside style="display: flex; flex-direction: column; gap: 20px;">

                <div class="card" style="background: var(--secondary); border-color: transparent; padding: 32px; border-radius: var(--r-lg); text-align: center;" data-aos="fade-up">
                    <div style="font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--primary); font-weight: 600; margin-bottom: 12px;">
                        Current APS
                    </div>
                    <div style="font-family: var(--font-display); font-size: 3.5rem; font-weight: 700; color: var(--primary); line-height: 1; margin-bottom: 8px;">
                        @Model.Aps
                    </div>
                    <div style="font-size: 0.85rem; color: var(--primary); opacity: 0.75;">
                        Based on @Model.SubjectCount subject@(Model.SubjectCount == 1 ? "" : "s")
                    </div>
                    <a asp-action="Results" class="btn-pill btn-pill-sm btn-pill-block" style="margin-top: 20px; background: var(--primary); border-color: var(--primary);">
                        <i class="fas fa-plus" style="font-size: 0.75rem;"></i>
                        Manage results
                    </a>
                </div>

                <div class="card" style="padding: 24px; border-radius: var(--r-lg);" data-aos="fade-up">
                    <div style="font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--brown-medium); font-weight: 600; margin-bottom: 12px;">
                        Next steps
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 10px;">
                        <a asp-action="Results" style="display: flex; align-items: center; gap: 10px; font-size: 0.92rem; padding: 8px 0;">
                            <i class="fas fa-book-open" style="color: var(--primary); width: 18px;"></i>
                            Capture your subjects
                        </a>
                        <a asp-controller="Eligibility" asp-action="Matches" style="display: flex; align-items: center; gap: 10px; font-size: 0.92rem; padding: 8px 0;">
                            <i class="fas fa-check-circle" style="color: var(--primary); width: 18px;"></i>
                            See what you qualify for
                        </a>
                        <a asp-controller="Programmes" asp-action="Index" style="display: flex; align-items: center; gap: 10px; font-size: 0.92rem; padding: 8px 0;">
                            <i class="fas fa-compass" style="color: var(--primary); width: 18px;"></i>
                            Browse programmes
                        </a>
                    </div>
                </div>

            </aside>
        </div>
    </div>
</section>

<style>
    .profile-layout {
        display: grid;
        grid-template-columns: 1fr 340px;
        gap: 32px;
        align-items: start;
    }

    @@media (max-width: 992px) {
        .profile-layout {
            grid-template-columns: 1fr;
        }
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}