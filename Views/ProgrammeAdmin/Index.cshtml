@model IEnumerable<EducareSA.Models.Programme>
@{
    ViewData["Title"] = "Manage Programmes";
    var programmes = Model.OrderBy(p => p.Faculty.University.ShortName).ThenBy(p => p.Name).ToList();
}

<section style="padding: 48px 0 32px;">
    <div class="shell">
        <div class="page-header" style="margin: 0;">
            <div>
                <span class="eyebrow">Admin</span>
                <h1 style="font-size: clamp(1.75rem, 3.5vw, 2.5rem); margin-bottom: 8px;">Programmes</h1>
                <p style="color: var(--brown-medium); margin: 0;">
                    @programmes.Count total · manage requirements, fees and visibility.
                </p>
            </div>
            <a asp-action="Create" class="btn-pill">
                <i class="fas fa-plus" style="font-size: 0.8rem;"></i>
                Add programme
            </a>
        </div>
    </div>
</section>

<section style="padding: 0 0 100px;">
    <div class="shell">

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger" style="margin-bottom: 20px;">@TempData["Error"]</div>
        }

        <div class="card" style="border-radius: var(--r-lg); overflow: hidden;">
            <div style="overflow-x: auto;">
                <table class="table table-hover" style="margin: 0;">
                    <thead>
                        <tr>
                            <th>Programme</th>
                            <th style="width: 110px;">Type</th>
                            <th>University</th>
                            <th style="width: 90px;">NQF</th>
                            <th style="width: 100px;">Verified</th>
                            <th style="width: 90px;">Status</th>
                            <th style="width: 220px; text-align: right;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in programmes)
                        {
                            <tr>
                                <td>
                                    <div style="font-weight: 500;">@p.Name</div>
                                    @if (!string.IsNullOrWhiteSpace(p.QualificationCode))
                                    {
                                        <div style="font-size: 0.78rem; color: var(--brown-medium);">@p.QualificationCode</div>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(p.QualificationType))
                                    {
                                        <span class="badge bg-secondary">@p.QualificationType</span>
                                    }
                                </td>
                                <td style="font-size: 0.9rem; color: var(--brown-medium);">
                                    @p.Faculty?.University?.ShortName
                                    <div style="font-size: 0.78rem;">@p.Faculty?.Name</div>
                                </td>
                                <td>@(p.NQFLevel?.ToString() ?? "—")</td>
                                <td>
                                    @if (p.DataVerified)
                                    {
                                        <span class="badge bg-success">Verified</span>
                                    }
                                    else
                                    {
                                        <span class="badge" style="background: var(--warning-bg); color: var(--warning);">Unverified</span>
                                    }
                                </td>
                                <td>
                                    @if (p.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactive</span>
                                    }
                                </td>
                                <td style="text-align: right;">
                                    <a asp-action="Details" asp-route-id="@p.ProgrammeId"
                                       class="btn-pill-outline btn-pill btn-pill-sm" style="padding: 6px 12px; font-size: 0.78rem;">View</a>
                                    <a asp-action="Edit" asp-route-id="@p.ProgrammeId"
                                       class="btn-pill btn-pill-sm" style="padding: 6px 14px; font-size: 0.78rem; margin-left: 4px;">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@p.ProgrammeId"
                                       class="btn-pill-outline btn-pill btn-pill-sm" style="padding: 6px 12px; font-size: 0.78rem; margin-left: 4px; color: var(--danger); border-color: var(--danger);">Delete</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div style="margin-top: 24px;">
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="btn-pill-outline btn-pill">
                <i class="fas fa-arrow-left" style="font-size: 0.75rem;"></i>
                Back to dashboard
            </a>
        </div>
    </div>
</section>