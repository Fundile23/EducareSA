@model EducareSA.Models.Programme
@{
    ViewData["Title"] = Model.Name;
}

<section style="padding: 48px 0 32px;">
    <div class="shell">
        <nav style="margin-bottom: 20px; font-size: 0.85rem;">
            <a asp-action="Index" style="color: var(--brown-medium);">Programmes</a>
            <span style="color: var(--brown-soft); margin: 0 8px;">/</span>
            <span style="color: var(--primary); font-weight: 500;">@Model.Name</span>
        </nav>

        <h1 style="font-size: clamp(1.75rem, 3.5vw, 2.5rem); margin-bottom: 8px;">@Model.Name</h1>
        <p style="color: var(--brown-medium); margin: 0;">
            @Model.Faculty?.University?.Name · @Model.Faculty?.Name
            @if (!Model.IsActive)
            {
                <span class="badge bg-danger" style="margin-left: 10px;">Inactive</span>
            }
            @if (!Model.DataVerified)
            {
                <span class="badge" style="background: var(--warning-bg); color: var(--warning); margin-left: 10px;">Unverified</span>
            }
        </p>
    </div>
</section>

<section style="padding: 0 0 100px;">
    <div class="shell">
        <div style="display: grid; grid-template-columns: 1fr 320px; gap: 32px; align-items: start;" class="admin-details-layout">

            <div class="card" style="padding: 32px; border-radius: var(--r-lg);">
                <h3 style="font-family: var(--font-display); margin: 0 0 20px; font-size: 1.15rem;">Details</h3>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 24px;">
                    <div>
                        <div class="form-label">Type</div>
                        <div>@(string.IsNullOrWhiteSpace(Model.QualificationType) ? "—" : Model.QualificationType)</div>
                    </div>
                    <div>
                        <div class="form-label">Code</div>
                        <div>@(string.IsNullOrWhiteSpace(Model.QualificationCode) ? "—" : Model.QualificationCode)</div>
                    </div>
                    <div>
                        <div class="form-label">NQF Level</div>
                        <div>@(Model.NQFLevel?.ToString() ?? "—")</div>
                    </div>
                    <div>
                        <div class="form-label">Duration</div>
                        <div>@(Model.DurationYears.HasValue ? $"{Model.DurationYears.Value:0.#} years" : "—")</div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <div style="padding-top: 24px; border-top: 1px solid var(--border); margin-bottom: 20px;">
                        <div class="form-label">Description</div>
                        <p style="color: var(--brown-medium); line-height: 1.7; margin: 0;">@Model.Description</p>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.SourceUrl))
                {
                    <div style="padding-top: 24px; border-top: 1px solid var(--border);">
                        <div class="form-label">Source</div>
                        <a href="@Model.SourceUrl" target="_blank" rel="noopener">@Model.SourceUrl</a>
                        @if (Model.LastVerified.HasValue)
                        {
                            <div style="font-size: 0.85rem; color: var(--brown-medium); margin-top: 4px;">
                                Last verified: @Model.LastVerified.Value.ToString("dd MMM yyyy")
                            </div>
                        }
                    </div>
                }
            </div>

            <aside class="card" style="padding: 24px; border-radius: var(--r-lg);">
                <div class="form-label">Actions</div>
                <div style="display: flex; flex-direction: column; gap: 8px;">
                    <a asp-action="Edit" asp-route-id="@Model.ProgrammeId" class="btn-pill btn-pill-block">
                        <i class="fas fa-pen" style="font-size: 0.8rem;"></i>
                        Edit
                    </a>
                    <a asp-controller="Programmes" asp-action="Details" asp-route-id="@Model.ProgrammeId"
                       class="btn-pill-outline btn-pill btn-pill-block" target="_blank">
                        <i class="fas fa-external-link-alt" style="font-size: 0.8rem;"></i>
                        View public page
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.ProgrammeId"
                       class="btn-pill-outline btn-pill btn-pill-block" style="color: var(--danger); border-color: var(--danger);">
                        <i class="fas fa-trash" style="font-size: 0.8rem;"></i>
                        Delete
                    </a>
                </div>

                <div class="form-label" style="margin-top: 24px;">Meta</div>
                <div style="font-size: 0.85rem; color: var(--brown-medium); line-height: 1.9;">
                    <div>ID: @Model.ProgrammeId</div>
                    <div>Faculty ID: @Model.FacultyId</div>
                    <div>Campus ID: @(Model.CampusId?.ToString() ?? "—")</div>
                </div>
            </aside>

        </div>
    </div>
</section>

<style>
    @@media (max-width: 900px) {
        .admin-details-layout {
            grid-template-columns: 1fr !important;
        }
    }
</style>