@model IEnumerable<EducareSA.Models.University>

@{
    ViewData["Title"] = "Universities";
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1>South African Universities</h1>
            <p class="text-muted">
                Explore universities, campuses and programmes.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            Add University
        </a>

    </div>

    <div class="row">

        @foreach (var university in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">

                <div class="card h-100 shadow-sm">

                    <div class="card-body">

                        <h4 class="card-title">
                            @university.Name
                        </h4>

                        <p class="text-muted">
                            @university.ShortName
                        </p>

                        <p>
                            @university.City,
                            @university.Province
                        </p>

                        @if (!string.IsNullOrEmpty(university.Description))
                        {
                            <p>
                                @university.Description
                            </p>
                        }

                        <div class="mt-3">

                            <a asp-action="Details"
                               asp-route-id="@university.UniversityId"
                               class="btn btn-outline-primary">
                                View
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@university.UniversityId"
                               class="btn btn-outline-secondary">
                                Edit
                            </a>

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>

</div>