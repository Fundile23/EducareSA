@model IEnumerable<EducareSA.Models.University>
@{
    ViewData["Title"] = "Universities";
}

<div style="background-image: linear-gradient(rgba(100, 48, 61, 0.85), rgba(100, 48, 61, 0.85)), url('/images/university-sign.jpg'); background-size: cover; background-position: center; background-attachment: fixed; min-height: calc(100vh - 76px);">

    <section style="padding: 64px 0 48px;">
        <div class="shell">
            <div style="max-width: 720px;" data-aos="fade-right">
                <span class="eyebrow" style="color: var(--secondary);">Directory</span>
                <h1 style="font-size: clamp(2rem, 4vw, 3rem); margin-bottom: 12px; color: var(--cream);">
                    South African <span style="color: var(--secondary);">universities</span>
                </h1>
                <p style="font-size: 1.05rem; color: var(--beige-medium); margin: 0;">
                    @Model.Count() public universities across all nine provinces.
                </p>
            </div>
        </div>
    </section>

    <section style="padding: 24px 0 100px;">
        <div class="shell">
            <div class="card-grid-3">
                @{
                    var i = 0;
                }
                @foreach (var u in Model.OrderBy(x => x.Name))
                {
                    var delay = (i % 6) * 80;
                    i++;

                    <a asp-action="Details" asp-route-id="@u.UniversityId"
                       class="card card-lift"
                       style="text-decoration: none; display: flex; flex-direction: column;"
                       data-aos="fade-up" data-aos-delay="@delay">

                        <div style="padding: 28px; display: flex; flex-direction: column; flex: 1;">

                            <div style="height: 64px; display: flex; align-items: center; margin-bottom: 20px;">
                                @if (!string.IsNullOrWhiteSpace(u.LogoUrl))
                                {
                                    <img src="@u.LogoUrl" alt="@u.Name logo"
                                         style="max-height: 64px; max-width: 140px; object-fit: contain;" />
                                }
                                else
                                {
                                    <div style="width: 64px; height: 64px; border-radius: var(--r-md); background: var(--primary); color: var(--white); display: flex; align-items: center; justify-content: center; font-family: var(--font-display); font-weight: 700; font-size: 1.15rem; letter-spacing: -0.02em;">
                                        @u.ShortName
                                    </div>
                                }
                            </div>

                            <h4 style="margin: 0 0 8px; font-size: 1.1rem; font-family: var(--font-display); line-height: 1.3; color: var(--primary);">
                                @u.Name
                            </h4>

                            <div style="font-size: 0.85rem; color: var(--brown-medium); margin-bottom: 18px;">
                                <i class="fas fa-location-dot" style="font-size: 0.75rem; margin-right: 6px; color: var(--brown-soft);"></i>
                                @u.City, @u.Province
                            </div>

                            @if (!string.IsNullOrWhiteSpace(u.Description))
                            {
                                <p style="font-size: 0.88rem; color: var(--brown-medium); line-height: 1.55; margin: 0 0 20px; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                                    @u.Description
                                </p>
                            }

                            <div style="margin-top: auto; padding-top: 16px; border-top: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center;">
                                <span style="font-size: 0.82rem; color: var(--brown-medium);">
                                    @u.Campuses.Count campus@(u.Campuses.Count == 1 ? "" : "es")
                                </span>
                                <span style="color: var(--primary); font-size: 0.85rem; font-weight: 500;">
                                    View <i class="fas fa-arrow-right" style="font-size: 0.7rem;"></i>
                                </span>
                            </div>

                        </div>
                    </a>
                }
            </div>
        </div>
    </section>

</div>