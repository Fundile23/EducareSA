@model EducareSA.Models.Campus
@{
    ViewData["Title"] = Model.Name;
}

<section style="padding: 48px 0 32px;">
    <div class="shell">
        <nav style="margin-bottom: 20px; font-size: 0.85rem;">
            <a asp-action="Index" style="color: var(--brown-medium);">Campuses</a>
            <span style="color: var(--brown-soft); margin: 0 8px;">/</span>
            <span style="color: var(--primary); font-weight: 500;">@Model.Name</span>
        </nav>

        <h1 style="font-size: clamp(1.75rem, 3.5vw, 2.5rem); margin-bottom: 8px;">@Model.Name</h1>
        <p style="color: var(--brown-medium); margin: 0;">
            @Model.University?.Name
            @if (!Model.IsActive)
            {
                <span class="badge bg-danger" style="margin-left: 10px;">Inactive</span>
            }
        </p>
    </div>
</section>

<section style="padding: 0 0 100px;">
    <div class="shell">
        <div style="display: grid; grid-template-columns: 1fr 320px; gap: 32px; align-items: start;" class="admin-details-layout">

            <div>
                @if (!string.IsNullOrWhiteSpace(Model.HeroImageUrl))
                {
                    <div style="border-radius: var(--r-lg); overflow: hidden; margin-bottom: 24px;">
                        <img src="@Model.HeroImageUrl" alt="@Model.Name"
                             style="width: 100%; height: 320px; object-fit: cover;" />
                    </div>
                }

                <div class="card" style="padding: 32px; border-radius: var(--r-lg);">
                    <h3 style="font-family: var(--font-display); margin: 0 0 20px; font-size: 1.15rem;">Location</h3>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
                        <div>
                            <div class="form-label">City</div>
                            <div>@(string.IsNullOrWhiteSpace(Model.City) ? "—" : Model.City)</div>
                        </div>
                        <div>
                            <div class="form-label">Province</div>
                            <div>@(string.IsNullOrWhiteSpace(Model.Province) ? "—" : Model.Province)</div>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Address))
                    {
                        <div style="padding-top: 20px; border-top: 1px solid var(--border);">
                            <div class="form-label">Address</div>
                            <div>@Model.Address</div>
                        </div>
                    }

                    @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
                    {
                        <div style="padding-top: 20px; border-top: 1px solid var(--border); margin-top: 20px;">
                            <div class="form-label">Coordinates</div>
                            <div style="font-family: monospace; font-size: 0.88rem;">
                                @Model.Latitude.Value.ToString("F6"), @Model.Longitude.Value.ToString("F6")
                            </div>
                        </div>
                    }
                </div>
            </div>

            <aside class="card" style="padding: 24px; border-radius: var(--r-lg);">
                <div class="form-label">Actions</div>
                <div style="display: flex; flex-direction: column; gap: 8px;">
                    <a asp-action="Edit" asp-route-id="@Model.CampusId" class="btn-pill btn-pill-block">
                        <i class="fas fa-pen" style="font-size: 0.8rem;"></i>
                        Edit
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.CampusId"
                       class="btn-pill-outline btn-pill btn-pill-block" style="color: var(--danger); border-color: var(--danger);">
                        <i class="fas fa-trash" style="font-size: 0.8rem;"></i>
                        Delete
                    </a>
                </div>

                <div class="form-label" style="margin-top: 24px;">Meta</div>
                <div style="font-size: 0.85rem; color: var(--brown-medium); line-height: 1.9;">
                    <div>ID: @Model.CampusId</div>
                    <div>University ID: @Model.UniversityId</div>
                </div>
            </aside>

        </div>
    </div>
</section>

<style>
    @@media (max-width: 900px) {
        .admin-details-layout {
            grid-template-columns: 1fr !important;
        }
    }
</style>