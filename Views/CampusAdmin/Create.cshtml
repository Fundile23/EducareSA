@model EducareSA.Models.Campus
@{
    ViewData["Title"] = "Add Campus";
    var universities = ViewBag.Universities as List<EducareSA.Models.University> ?? new List<EducareSA.Models.University>();
}

<section style="padding: 48px 0 32px;">
    <div class="shell">
        <nav style="margin-bottom: 20px; font-size: 0.85rem;">
            <a asp-action="Index" style="color: var(--brown-medium);">Campuses</a>
            <span style="color: var(--brown-soft); margin: 0 8px;">/</span>
            <span style="color: var(--primary); font-weight: 500;">Add new</span>
        </nav>

        <h1 style="font-size: clamp(1.75rem, 3.5vw, 2.5rem); margin-bottom: 8px;">Add a campus</h1>
        <p style="color: var(--brown-medium);">Create a new campus under an existing university.</p>
    </div>
</section>

<section style="padding: 0 0 100px;">
    <div class="shell">
        <form asp-action="Create" method="post" class="card" style="padding: 32px; border-radius: var(--r-lg); max-width: 780px;">
            <div asp-validation-summary="ModelOnly" class="text-danger small" style="margin-bottom: 16px;"></div>

            <h3 style="font-family: var(--font-display); margin: 0 0 20px; font-size: 1.15rem;">Basic details</h3>

            <div style="margin-bottom: 20px;">
                <label class="form-label">University</label>
                <select asp-for="UniversityId" class="form-select">
                    <option value="">-- Select university --</option>
                    @foreach (var u in universities)
                    {
                        <option value="@u.UniversityId">@u.Name (@u.ShortName)</option>
                    }
                </select>
                <span asp-validation-for="UniversityId" class="text-danger small"></span>
            </div>

            <div style="margin-bottom: 20px;">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" placeholder="e.g. Rondebosch Campus" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
                <div>
                    <label asp-for="City" class="form-label"></label>
                    <input asp-for="City" class="form-control" />
                    <span asp-validation-for="City" class="text-danger small"></span>
                </div>
                <div>
                    <label asp-for="Province" class="form-label"></label>
                    <input asp-for="Province" class="form-control" />
                    <span asp-validation-for="Province" class="text-danger small"></span>
                </div>
            </div>

            <div style="margin-bottom: 20px;">
                <label asp-for="Address" class="form-label"></label>
                <input asp-for="Address" class="form-control" />
                <span asp-validation-for="Address" class="text-danger small"></span>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
                <div>
                    <label asp-for="Latitude" class="form-label"></label>
                    <input asp-for="Latitude" class="form-control" type="number" step="any" />
                </div>
                <div>
                    <label asp-for="Longitude" class="form-label"></label>
                    <input asp-for="Longitude" class="form-control" type="number" step="any" />
                </div>
            </div>

            <h3 style="font-family: var(--font-display); margin: 32px 0 20px; font-size: 1.15rem;">Hero image</h3>

            <div style="margin-bottom: 20px;">
                <label asp-for="HeroImageUrl" class="form-label">Hero image URL</label>
                <input asp-for="HeroImageUrl" class="form-control" placeholder="https://..." />
                <span asp-validation-for="HeroImageUrl" class="text-danger small"></span>
            </div>

            <div style="margin-bottom: 28px;">
                <label style="display: flex; align-items: center; gap: 10px; cursor: pointer;">
                    <input asp-for="IsActive" type="checkbox" checked style="width: 18px; height: 18px; accent-color: var(--primary);" />
                    <span style="font-size: 0.95rem;">Active — visible on the public site</span>
                </label>
            </div>

            <div style="display: flex; gap: 12px; flex-wrap: wrap;">
                <button type="submit" class="btn-pill">
                    <i class="fas fa-plus" style="font-size: 0.8rem;"></i>
                    Create campus
                </button>
                <a asp-action="Index" class="btn-pill-outline btn-pill">Cancel</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}