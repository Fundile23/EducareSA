@model IEnumerable<EducareSA.Models.Bursary>

@{
    ViewData["Title"] = "Manage Bursaries";
}

<div style="background: #f8f5f2; min-height: calc(100vh - 76px);">

    <section style="padding: 48px 0;">
        <div class="shell">

            <div style="display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; flex-wrap: wrap; margin-bottom: 32px;">

                <div>
                    <span class="eyebrow" style="color: var(--primary);">
                        Administration
                    </span>

                    <h1 style="margin-bottom: 8px;">
                        Manage Bursaries
                    </h1>

                    <p style="color: #666; margin: 0;">
                        Add, update and manage bursary opportunities available to students.
                    </p>
                </div>

                <div>
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="fas fa-plus me-1"></i>
                        Add Bursary
                    </a>
                </div>

            </div>

            @if (!Model.Any())
            {
                <div class="card" style="padding: 40px; text-align: center;">

                    <i class="fas fa-graduation-cap"
                       style="font-size: 2.5rem; margin-bottom: 16px; color: var(--primary);">
                    </i>

                    <h3>No bursaries found</h3>

                    <p style="color: #666; margin-bottom: 24px;">
                        There are currently no bursaries in the system.
                    </p>

                    <a asp-action="Create" class="btn btn-primary">
                        Add First Bursary
                    </a>

                </div>
            }
            else
            {
                <div class="card" style="padding: 0; overflow: hidden;">

                    <div style="overflow-x: auto;">

                        <table style="width: 100%; border-collapse: collapse;">

                            <thead>
                                <tr style="border-bottom: 1px solid #ddd;">
                                    <th style="padding: 16px; text-align: left;">
                                        Bursary
                                    </th>

                                    <th style="padding: 16px; text-align: left;">
                                        Provider
                                    </th>

                                    <th style="padding: 16px; text-align: left;">
                                        Faculty
                                    </th>

                                    <th style="padding: 16px; text-align: left;">
                                        Closing Date
                                    </th>

                                    <th style="padding: 16px; text-align: left;">
                                        Status
                                    </th>

                                    <th style="padding: 16px; text-align: right;">
                                        Actions
                                    </th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var bursary in Model)
                                {
                                    <tr style="border-bottom: 1px solid #eee;">

                                        <td style="padding: 16px;">
                                            <strong>
                                                @bursary.Name
                                            </strong>
                                        </td>

                                        <td style="padding: 16px;">
                                            @if (!string.IsNullOrWhiteSpace(bursary.Provider))
                                            {
                                                @bursary.Provider
                                            }
                                            else
                                            {
                                                <span style="color: #999;">
                                                    Not specified
                                                </span>
                                            }
                                        </td>

                                        <td style="padding: 16px;">
                                            @if (bursary.Faculty != null)
                                            {
                                                @bursary.Faculty.Name
                                            }
                                            else
                                            {
                                                <span style="color: #999;">
                                                    Not assigned
                                                </span>
                                            }
                                        </td>

                                        <td style="padding: 16px;">
                                            @if (bursary.ClosingDate.HasValue)
                                            {
                                                @bursary.ClosingDate.Value.ToString("dd MMM yyyy")
                                            }
                                            else
                                            {
                                                <span style="color: #999;">
                                                    Not specified
                                                </span>
                                            }
                                        </td>

                                        <td style="padding: 16px;">
                                            @if (bursary.IsActive)
                                            {
                                                <span style="color: #287a45; font-weight: 600;">
                                                    Active
                                                </span>
                                            }
                                            else
                                            {
                                                <span style="color: #999; font-weight: 600;">
                                                    Inactive
                                                </span>
                                            }
                                        </td>

                                        <td style="padding: 16px; text-align: right;">

                                            <a asp-action="Details"
                                               asp-route-id="@bursary.BursaryId"
                                               class="btn btn-sm btn-outline-secondary me-1">
                                                Details
                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@bursary.BursaryId"
                                               class="btn btn-sm btn-outline-primary me-1">
                                                Edit
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@bursary.BursaryId"
                                               class="btn btn-sm btn-outline-danger">
                                                Delete
                                            </a>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>
            }

        </div>
    </section>

</div>