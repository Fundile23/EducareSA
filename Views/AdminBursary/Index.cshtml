@model IEnumerable<EducareSA.Models.Bursary>
@{
    ViewData["Title"] = "Manage Bursaries";
}

<section style="padding: 48px 0 32px;">
    <div class="shell">
        <div class="page-header" style="margin: 0;">
            <div>
                <span class="eyebrow">Admin</span>
                <h1 style="font-size: clamp(1.75rem, 3.5vw, 2.5rem); margin-bottom: 8px;">Bursaries</h1>
                <p style="color: var(--brown-medium); margin: 0;">
                    @Model.Count() total · manage bursary opportunities.
                </p>
            </div>
            <a asp-action="Create" class="btn-pill">
                <i class="fas fa-plus" style="font-size: 0.8rem;"></i>
                Add bursary
            </a>
        </div>
    </div>
</section>

<section style="padding: 0 0 100px;">
    <div class="shell">

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger" style="margin-bottom: 20px;">@TempData["Error"]</div>
        }

        @if (!Model.Any())
        {
            <div class="card" style="padding: 72px 32px; text-align: center; border-radius: var(--r-xl);">
                <div style="width: 80px; height: 80px; border-radius: 50%; background: var(--secondary); display: flex; align-items: center; justify-content: center; font-size: 1.8rem; color: var(--primary); margin: 0 auto 24px;">
                    <i class="fas fa-graduation-cap"></i>
                </div>
                <h3 style="font-family: var(--font-display); font-size: 1.4rem; margin-bottom: 12px;">
                    No bursaries yet
                </h3>
                <p class="text-muted" style="max-width: 420px; margin: 0 auto 28px;">
                    Add the first bursary to make it visible to students.
                </p>
                <a asp-action="Create" class="btn-pill">Add first bursary</a>
            </div>
        }
        else
        {
            <div class="card" style="border-radius: var(--r-lg); overflow: hidden;">
                <div style="overflow-x: auto;">
                    <table class="table table-hover" style="margin: 0;">
                        <thead>
                            <tr>
                                <th>Bursary</th>
                                <th>Provider</th>
                                <th style="width: 130px;">Closing date</th>
                                <th style="width: 90px;">Status</th>
                                <th style="width: 220px; text-align: right;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in Model.OrderBy(x => x.Name))
                            {
                                <tr>
                                    <td>
                                        <div style="font-weight: 500;">@b.Name</div>
                                        @if (!string.IsNullOrWhiteSpace(b.Coverage))
                                        {
                                            <div style="font-size: 0.78rem; color: var(--brown-medium);">
                                                @b.Coverage
                                            </div>
                                        }
                                    </td>
                                    <td style="color: var(--brown-medium); font-size: 0.9rem;">
                                        @(string.IsNullOrWhiteSpace(b.Provider) ? "—" : b.Provider)
                                    </td>
                                    <td style="font-size: 0.88rem;">
                                        @if (b.ClosingDate.HasValue)
                                        {
                                            @b.ClosingDate.Value.ToString("dd MMM yyyy")
                                        }
                                        else
                                        {
                                            <span style="color: var(--brown-soft);">—</span>
                                        }
                                    </td>
                                    <td>
                                        @if (b.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Inactive</span>
                                        }
                                    </td>
                                    <td style="text-align: right;">
                                        <a asp-action="Details" asp-route-id="@b.BursaryId"
                                           class="btn-pill-outline btn-pill btn-pill-sm" style="padding: 6px 12px; font-size: 0.78rem;">View</a>
                                        <a asp-action="Edit" asp-route-id="@b.BursaryId"
                                           class="btn-pill btn-pill-sm" style="padding: 6px 14px; font-size: 0.78rem; margin-left: 4px;">Edit</a>
                                        <a asp-action="Delete" asp-route-id="@b.BursaryId"
                                           class="btn-pill-outline btn-pill btn-pill-sm" style="padding: 6px 12px; font-size: 0.78rem; margin-left: 4px; color: var(--danger); border-color: var(--danger);">Delete</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <div style="margin-top: 24px;">
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="btn-pill-outline btn-pill">
                <i class="fas fa-arrow-left" style="font-size: 0.75rem;"></i>
                Back to dashboard
            </a>
        </div>
    </div>
</section>