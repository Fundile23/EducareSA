@model EducareSA.Models.Bursary
@{
    ViewData["Title"] = Model.Name;
}

<section style="padding: 48px 0 32px;">
    <div class="shell">
        <nav style="margin-bottom: 20px; font-size: 0.85rem;">
            <a asp-action="Index" style="color: var(--brown-medium);">Bursaries</a>
            <span style="color: var(--brown-soft); margin: 0 8px;">/</span>
            <span style="color: var(--primary); font-weight: 500;">@Model.Name</span>
        </nav>

        <h1 style="font-size: clamp(1.75rem, 3.5vw, 2.5rem); margin-bottom: 8px;">@Model.Name</h1>
        <p style="color: var(--brown-medium); margin: 0;">
            @(string.IsNullOrWhiteSpace(Model.Provider) ? "Provider not specified" : Model.Provider)
            @if (!Model.IsActive)
            {
                <span class="badge bg-danger" style="margin-left: 10px;">Inactive</span>
            }
        </p>
    </div>
</section>

<section style="padding: 0 0 100px;">
    <div class="shell">
        <div class="admin-details-layout">

            <div class="card" style="padding: 32px; border-radius: var(--r-lg);">

                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <div style="margin-bottom: 24px;">
                        <div class="form-label">Description</div>
                        <p style="color: var(--brown-medium); line-height: 1.7; margin: 0; white-space: pre-line;">
                            @Model.Description
                        </p>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Coverage))
                {
                    <div style="padding-top: 24px; border-top: 1px solid var(--border); margin-bottom: 24px;">
                        <div class="form-label">Coverage</div>
                        <p style="color: var(--brown-medium); line-height: 1.7; margin: 0; white-space: pre-line;">
                            @Model.Coverage
                        </p>
                    </div>
                }

                <div style="padding-top: 24px; border-top: 1px solid var(--border);">
                    <div class="form-label">Application dates</div>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                        <div>
                            <div style="font-size: 0.82rem; color: var(--brown-medium);">Opening</div>
                            <div style="font-weight: 500;">
                                @(Model.OpeningDate.HasValue
                                    ? Model.OpeningDate.Value.ToString("dd MMM yyyy")
                                    : "—")
                            </div>
                        </div>
                        <div>
                            <div style="font-size: 0.82rem; color: var(--brown-medium);">Closing</div>
                            <div style="font-weight: 500;">
                                @(Model.ClosingDate.HasValue
                                    ? Model.ClosingDate.Value.ToString("dd MMM yyyy")
                                    : "—")
                            </div>
                        </div>
                    </div>
                </div>

                <div style="padding-top: 24px; border-top: 1px solid var(--border); margin-top: 24px;">
                    <div class="form-label">Eligibility</div>
                    <div style="margin-bottom: 12px;">
                        <span style="font-size: 0.82rem; color: var(--brown-medium);">Minimum APS:</span>
                        <strong style="margin-left: 6px;">
                            @(Model.MinimumAPS.HasValue
                                ? Model.MinimumAPS.Value.ToString("0.##")
                                : "—")
                        </strong>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.EligibilityNotes))
                    {
                        <p style="color: var(--brown-medium); line-height: 1.7; margin: 0; white-space: pre-line;">
                            @Model.EligibilityNotes
                        </p>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.WebsiteUrl))
                {
                    <div style="padding-top: 24px; border-top: 1px solid var(--border); margin-top: 24px;">
                        <div class="form-label">Website</div>
                        <a href="@Model.WebsiteUrl" target="_blank" rel="noopener noreferrer">@Model.WebsiteUrl</a>
                    </div>
                }

            </div>

            <aside class="card" style="padding: 24px; border-radius: var(--r-lg);">
                <div class="form-label">Actions</div>
                <div style="display: flex; flex-direction: column; gap: 8px;">
                    <a asp-action="Edit" asp-route-id="@Model.BursaryId" class="btn-pill btn-pill-block">
                        <i class="fas fa-pen" style="font-size: 0.8rem;"></i>
                        Edit
                    </a>
                    <a asp-controller="Bursary" asp-action="Details" asp-route-id="@Model.BursaryId"
                       class="btn-pill-outline btn-pill btn-pill-block" target="_blank">
                        <i class="fas fa-external-link-alt" style="font-size: 0.8rem;"></i>
                        View public page
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.BursaryId"
                       class="btn-pill-outline btn-pill btn-pill-block" style="color: var(--danger); border-color: var(--danger);">
                        <i class="fas fa-trash" style="font-size: 0.8rem;"></i>
                        Delete
                    </a>
                </div>

                <div class="form-label" style="margin-top: 24px;">Meta</div>
                <div style="font-size: 0.85rem; color: var(--brown-medium); line-height: 1.9;">
                    <div>ID: @Model.BursaryId</div>
                    <div>Created: @Model.CreatedAt.ToString("dd MMM yyyy")</div>
                    <div>Updated: @Model.UpdatedAt.ToString("dd MMM yyyy")</div>
                </div>
            </aside>

        </div>
    </div>
</section>

<style>
    .admin-details-layout {
        display: grid;
        grid-template-columns: 1fr 320px;
        gap: 32px;
        align-items: start;
    }

    @@media (max-width: 900px) {
        .admin-details-layout {
            grid-template-columns: 1fr;
        }
    }
</style>