@model EducareSA.Models.Bursary
@{
    ViewData["Title"] = "Edit Bursary";
}

<section style="padding: 48px 0 32px;">
    <div class="shell">
        <nav style="margin-bottom: 20px; font-size: 0.85rem;">
            <a asp-action="Index" style="color: var(--brown-medium);">Bursaries</a>
            <span style="color: var(--brown-soft); margin: 0 8px;">/</span>
            <span style="color: var(--primary); font-weight: 500;">Edit @Model.Name</span>
        </nav>

        <h1 style="font-size: clamp(1.75rem, 3.5vw, 2.5rem); margin-bottom: 8px;">Edit bursary</h1>
        <p style="color: var(--brown-medium);">Update the details for this bursary opportunity.</p>
    </div>
</section>

<section style="padding: 0 0 100px;">
    <div class="shell">
        <form asp-action="Edit" method="post" class="card" style="padding: 32px; border-radius: var(--r-lg); max-width: 820px;">
            <input type="hidden" asp-for="BursaryId" />
            <input type="hidden" asp-for="CreatedAt" />
            <div asp-validation-summary="ModelOnly" class="text-danger small" style="margin-bottom: 16px;"></div>

            <h3 style="font-family: var(--font-display); margin: 0 0 20px; font-size: 1.15rem;">Basic details</h3>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
                <div>
                    <label asp-for="Name" class="form-label">Bursary name</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div>
                    <label asp-for="Provider" class="form-label">Provider</label>
                    <input asp-for="Provider" class="form-control" />
                    <span asp-validation-for="Provider" class="text-danger small"></span>
                </div>
            </div>

            <div style="margin-bottom: 20px;">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div style="margin-bottom: 20px;">
                <label asp-for="Coverage" class="form-label"></label>
                <textarea asp-for="Coverage" class="form-control" rows="2"></textarea>
                <span asp-validation-for="Coverage" class="text-danger small"></span>
            </div>

            <div style="margin-bottom: 20px;">
                <label asp-for="WebsiteUrl" class="form-label">Website URL</label>
                <input asp-for="WebsiteUrl" class="form-control" />
                <span asp-validation-for="WebsiteUrl" class="text-danger small"></span>
            </div>

            <h3 style="font-family: var(--font-display); margin: 32px 0 20px; font-size: 1.15rem;">Application dates</h3>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
                <div>
                    <label asp-for="OpeningDate" class="form-label">Opening date</label>
                    <input asp-for="OpeningDate" type="date" class="form-control" />
                    <span asp-validation-for="OpeningDate" class="text-danger small"></span>
                </div>
                <div>
                    <label asp-for="ClosingDate" class="form-label">Closing date</label>
                    <input asp-for="ClosingDate" type="date" class="form-control" />
                    <span asp-validation-for="ClosingDate" class="text-danger small"></span>
                </div>
            </div>

            <h3 style="font-family: var(--font-display); margin: 32px 0 20px; font-size: 1.15rem;">Eligibility</h3>

            <div style="margin-bottom: 20px; max-width: 260px;">
                <label asp-for="MinimumAPS" class="form-label">Minimum APS (optional)</label>
                <input asp-for="MinimumAPS" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="MinimumAPS" class="text-danger small"></span>
            </div>

            <div style="margin-bottom: 28px;">
                <label asp-for="EligibilityNotes" class="form-label">Eligibility notes</label>
                <textarea asp-for="EligibilityNotes" class="form-control" rows="4"></textarea>
                <span asp-validation-for="EligibilityNotes" class="text-danger small"></span>
            </div>

            <div style="margin-bottom: 28px;">
                <label style="display: flex; align-items: center; gap: 10px; cursor: pointer;">
                    <input asp-for="IsActive" type="checkbox"
                           style="width: 18px; height: 18px; accent-color: var(--primary);" />
                    <span style="font-size: 0.95rem;">Active — visible on the public site</span>
                </label>
            </div>

            <div style="display: flex; gap: 12px; flex-wrap: wrap;">
                <button type="submit" class="btn-pill">
                    <i class="fas fa-check" style="font-size: 0.8rem;"></i>
                    Save changes
                </button>
                <a asp-action="Index" class="btn-pill-outline btn-pill">Cancel</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}