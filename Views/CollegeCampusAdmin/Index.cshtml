@model IEnumerable<EducareSA.Models.CollegeCampus>

@{
    ViewData["Title"] = "Manage College Campuses";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Manage College Campuses</h2>
            <p class="text-muted mb-0">
                Manage campuses belonging to each TVET college.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Add Campus
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No campuses have been added yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Campus</th>
                        <th>College</th>
                        <th>City</th>
                        <th>Province</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var campus in Model)
                    {
                        <tr>
                            <td>@campus.Name</td>
                            <td>@campus.College?.Name</td>
                            <td>@campus.City</td>
                            <td>@campus.Province</td>

                            <td>
                                @if (campus.IsActive)
                                {
                                    <span class="badge bg-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Inactive
                                    </span>
                                }
                            </td>

                            <td>
                                <a asp-action="Edit"
                                   asp-route-id="@campus.CollegeCampusId"
                                   class="btn btn-sm btn-outline-primary">
                                    Edit
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@campus.CollegeCampusId"
                                   class="btn btn-sm btn-outline-danger">
                                    Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>