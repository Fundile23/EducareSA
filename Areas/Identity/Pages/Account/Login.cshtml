@page
@model LoginModel
@{
    ViewData["Title"] = "Log in";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<section style="min-height: 70vh; display: flex; align-items: center; padding: 48px 0;">
    <div class="shell" style="width: 100%;">
        <div class="auth-grid">

            <div class="card card-dark" style="padding: 48px; border-radius: var(--r-xl); position: relative; overflow: hidden;" data-aos="fade-right">
                <div style="position: absolute; top: -40%; right: -20%; width: 500px; height: 500px; background: radial-gradient(circle, rgba(195, 219, 231, 0.15) 0%, transparent 70%); border-radius: 50%; pointer-events: none;"></div>
                <div style="position: relative; z-index: 2;">
                    <div style="font-family: var(--font-display); font-weight: 700; font-size: 2rem; letter-spacing: -0.02em; color: var(--cream); margin-bottom: 24px;">
                        EducareSA.
                    </div>
                    <h2 style="font-family: var(--font-display); color: var(--cream); font-size: clamp(1.5rem, 3vw, 2rem); margin-bottom: 16px; line-height: 1.2;">
                        Welcome back.
                    </h2>
                    <p style="color: var(--beige-medium); font-size: 1rem; line-height: 1.6; margin-bottom: 32px;">
                        Sign in to see your matches, update your subjects, and check which programmes you qualify for.
                    </p>
                    <div style="display: flex; flex-direction: column; gap: 14px; margin-top: 32px;">
                        <div style="display: flex; gap: 12px; align-items: flex-start;">
                            <i class="fas fa-check-circle" style="color: var(--secondary); margin-top: 4px;"></i>
                            <div style="color: var(--beige-medium); font-size: 0.92rem;">Your results, saved securely</div>
                        </div>
                        <div style="display: flex; gap: 12px; align-items: flex-start;">
                            <i class="fas fa-check-circle" style="color: var(--secondary); margin-top: 4px;"></i>
                            <div style="color: var(--beige-medium); font-size: 0.92rem;">Real-time eligibility matches</div>
                        </div>
                        <div style="display: flex; gap: 12px; align-items: flex-start;">
                            <i class="fas fa-check-circle" style="color: var(--secondary); margin-top: 4px;"></i>
                            <div style="color: var(--beige-medium); font-size: 0.92rem;">87 programmes across 24 universities</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card" style="padding: 48px; border-radius: var(--r-xl);" data-aos="fade-left">
                <h1 style="font-family: var(--font-display); font-size: 1.75rem; margin: 0 0 8px;">Log in</h1>
                <p style="color: var(--brown-medium); margin: 0 0 32px; font-size: 0.95rem;">
                    Enter your details to continue.
                </p>

                <form id="account" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small" style="margin-bottom: 16px;" role="alert"></div>

                    <div style="margin-bottom: 20px;">
                        <label asp-for="Input.Email" class="form-label">Email</label>
                        <input asp-for="Input.Email" class="form-control" autocomplete="username"
                               aria-required="true" placeholder="you@example.com" />
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <div style="margin-bottom: 20px;">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <label asp-for="Input.Password" class="form-label">Password</label>
                            <a asp-page="./ForgotPassword" style="font-size: 0.8rem; color: var(--brown-medium);">Forgot?</a>
                        </div>
                        <input asp-for="Input.Password" type="password" class="form-control"
                               autocomplete="current-password" aria-required="true" placeholder="Your password" />
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>

                    <div style="margin-bottom: 28px;">
                        <label style="display: flex; align-items: center; gap: 10px; cursor: pointer; font-size: 0.9rem; color: var(--brown-medium);">
                            <input asp-for="Input.RememberMe" type="checkbox"
                                   style="width: 16px; height: 16px; accent-color: var(--primary);" />
                            <span>Keep me logged in</span>
                        </label>
                    </div>

                    <button id="login-submit" type="submit" class="btn-pill btn-pill-block btn-pill-lg">
                        Log in
                        <i class="fas fa-arrow-right" style="font-size: 0.8rem;"></i>
                    </button>

                    <div style="text-align: center; margin-top: 24px; padding-top: 24px; border-top: 1px solid var(--border);">
                        <span style="color: var(--brown-medium); font-size: 0.9rem;">Don't have an account? </span>
                        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl"
                           style="font-weight: 500; color: var(--primary);">Create one</a>
                    </div>
                </form>
            </div>

        </div>
    </div>
</section>

<style>
    .auth-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 32px;
        align-items: stretch;
        max-width: 1000px;
        margin: 0 auto;
    }

    @@media (max-width: 900px) {
        .auth-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}